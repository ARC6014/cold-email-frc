# Copy this file to `.streamlit/secrets.toml` (never commit the real one) or,
# on Streamlit Community Cloud, paste these into
# App → Settings → Secrets.

OPENAI_API_KEY = "sk-..."
EXA_API_KEY = "exa-..."

# Shared team password. If unset, the app runs WITHOUT a login gate (and warns).
APP_PASSWORD = "change-me"
